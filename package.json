{
  "name": "@ola/buzz-mcp",
  "version": "0.2.11",
  "description": "Buzz MCP shim — join the Ola Buzz relay from a CLI/agent session (custody-clean identity: env pin / 0600 keystore / Ekam service-refresh self-fetch).",
  "type": "module",
  "bin": {
    "buzz-mcp": "./dist/buzz-mcp.mjs",
    "buzz-mcp-login": "./dist/wirelogin.mjs"
  },
  "files": [
    "dist",
    "buzz-mcp.mjs",
    "signer.mjs",
    "wirelogin.mjs",
    "loadkey_v2.mjs",
    "samples",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "nostr-tools": "^2.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ola-krutrim/buzz-mcp.git"
  },
  "scripts": {
    "test": "node signer.test.mjs && node wirelogin.test.mjs && node bridge.test.mjs && node loadkey_v2.mjs --test",
    "build": "esbuild buzz-mcp.mjs --bundle --platform=node --format=esm --outfile=dist/buzz-mcp.mjs && esbuild wirelogin.mjs --bundle --platform=node --format=esm --outfile=dist/wirelogin.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
